# Copy to .env and fill in. Only the variables for the sources you crawl are
# needed. Every crawler container gets this whole file (env_file in the
# compose example), so keep it readable only by you: chmod 600 .env

# Image version to run (see the repo's releases); latest if unset.
#PELICAN_VERSION=0.1.0

# --- OpenSearch accounts (created by the opensearch-users job) -------------
# OpenSearch wants at least 8 characters with upper and lower case, a digit
# and a symbol, and rejects passwords that resemble the user name. Wrap a
# value in single quotes if it contains a $.
# pelican: the crawlers
OS_PASSWORD=
# pelican-status: the status page
OS_STATUS_PASSWORD=
# admin: full access, for you (optional)
OS_ADMIN_PASSWORD=
# pelican-reader: read-only, for a search UI such as Frogmouth (optional)
OS_READER_PASSWORD=

# --- Status page sign-in ----------------------------------------------------
# Required: the status page won't start without a password of 12+ characters.
# User name defaults to pelican.
STATUS_PASSWORD=
#STATUS_USERNAME=pelican

# --- SMB (config/shares.yaml default_credentials) --------------------------
SMB_USER=
SMB_PASS=
SMB_DOMAIN=

# --- Exchange Online / SharePoint Online (Entra app, client secret) --------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SECRET=

# --- Exchange permission export (exo-permissions; certificate auth) --------
# The tenant's .onmicrosoft.com domain. The certificate goes in secrets/exo.pfx.
EXO_ORGANIZATION=
EXO_CERT_PASSWORD=

# --- Optional ---------------------------------------------------------------
#TZ=Europe/London
