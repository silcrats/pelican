# Copy to .env and fill in. Only the variables for the sources you crawl are
# needed. Every crawler container gets this whole file (env_file in the
# compose example), so keep it readable only by you: chmod 600 .env

# Image version to run (see the repo's releases); latest if unset.
#PELICAN_VERSION=0.1.0

# --- OpenSearch accounts (created by the opensearch-users job) -------------
# OpenSearch wants at least 8 characters with upper and lower case, a digit
# and a symbol, and rejects passwords that resemble the user name. Wrap a
# value in single quotes if it contains a $.
# pelican: the crawlers
OS_PASSWORD=
# pelican-status: read-only stats, for the admin portal's Storage page
# (required with docker-compose.admin.yml)
OS_STATUS_PASSWORD=
# admin: full access, for you (optional)
OS_ADMIN_PASSWORD=
# pelican-reader: read-only, for a search UI such as Frogmouth (optional)
OS_READER_PASSWORD=

# Index snapshots (see Backups in the README): cron in TZ, or off.
#OS_SNAPSHOT_SCHEDULE=0 2 * * *
#OS_SNAPSHOT_KEEP=14

# --- Vector search (optional; see vector: in config/pelican.yaml) ----------
# All three lines turn it on: the setting, the embeddings service, and the
# key only OpenSearch uses to call it (any long random string). Applies to
# a new index only.
#VECTOR_ENABLED=true
#COMPOSE_PROFILES=vector
#EMBEDDINGS_API_KEY=
# OpenSearch's heap (default 2g). Re-indexing large documents holds their
# stored text and vectors in memory too, so give it 4g or more.
#OS_HEAP=4g
# With an NVIDIA GPU (see docker-compose.gpu.yml):
#COMPOSE_FILE=docker-compose.example.yml:docker-compose.gpu.yml
#EMBEDDINGS_IMAGE=ghcr.io/huggingface/text-embeddings-inference:86-1.9.4

# --- Admin portal (docker-compose.admin.yml; optional) ----------------------
# Workers send this to the portal to take jobs: 32+ random characters, e.g.
# from `openssl rand -hex 32`.
#WORKER_TOKEN=
# Sign-in against AD. bind_template uses {username}, e.g. {username}@example.local.
#LDAP_URL=ldaps://dc01.example.local:636
#LDAP_BIND_TEMPLATE={username}@example.local
#LDAP_BASE_DN=DC=example,DC=local
# Plain ldap:// with StartTLS instead of ldaps://:
#LDAP_START_TLS=true
# AD groups whose members are super admins (comma-separated). Other people
# sign in only if a scope in the portal names one of their groups.
#SUPER_ADMIN_GROUPS=Pelican Admins
# A local super-admin account (user pelican-admin), for first setup or when
# the directory is down. 16+ characters. Leave unset normally.
#ADMIN_BREAKGLASS_PASSWORD=
# Schedule given to imported and new sources, in minutes (0: manual only).
# Imported sources are crawled once as soon as a worker starts.
#DEFAULT_CRAWL_MINUTES=360
#DEFAULT_ACL_MINUTES=120
# true if the portal is served over HTTPS (behind a reverse proxy).
#ADMIN_SECURE_COOKIE=true

# --- SMB (config/shares.yaml default_credentials) --------------------------
SMB_USER=
SMB_PASS=
SMB_DOMAIN=

# --- Exchange Online / SharePoint Online (Entra app, client secret) --------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SECRET=

# --- Exchange permission export (exo-permissions; certificate auth) --------
# The tenant's .onmicrosoft.com domain. The certificate goes in secrets/exo.pfx.
EXO_ORGANIZATION=
EXO_CERT_PASSWORD=

# --- Optional ---------------------------------------------------------------
#TZ=Europe/London
