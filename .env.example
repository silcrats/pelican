# Copy to .env and fill in. Only the variables for the sources you crawl are
# needed. Every crawler container gets this whole file (env_file in the
# compose example), so keep it readable only by you: chmod 600 .env

# Image version to run (see the repo's releases); latest if unset.
#PELICAN_VERSION=0.1.0

# --- SMB (config/shares.yaml default_credentials) --------------------------
SMB_USER=
SMB_PASS=
SMB_DOMAIN=

# --- Exchange Online / SharePoint Online (Entra app, client secret) --------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SECRET=

# --- Exchange permission export (exo-permissions; certificate auth) --------
# The tenant's .onmicrosoft.com domain. The certificate goes in secrets/exo.pfx.
EXO_ORGANIZATION=
EXO_CERT_PASSWORD=

# --- Optional ---------------------------------------------------------------
#TZ=Europe/London
